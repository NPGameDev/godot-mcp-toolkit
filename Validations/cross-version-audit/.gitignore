# Build artifacts from the C# reflect-tool (regenerated by `dotnet run`/`dotnet build`).
scripts/reflect-tool/bin/
scripts/reflect-tool/obj/

# Raw per-version extension_api.json dumps + reflected GodotSharp surfaces are
# multi-MB and REGENERATED by the harness (dump_api.sh / reflect-tool), never
# committed. They belong under _TempForClaude/xversion-dumps by default; this
# guard only matters if a run is pointed at this directory.
dumps/
*.extension_api.json
extension_api.json
net-*.json
