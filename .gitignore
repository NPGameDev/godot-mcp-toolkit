# Godot 4.x editor-local state
.godot/
*.import

# Iter 08 distribution artifacts (AssetLib zip build output)
dist-plugin/

# IDE / editor-specific (user-machine paths, not portable)
.vscode/
.idea/

# Claude Code per-project state (created when running `claude` from this
# repo for dogfood). Local to the dev machine — settings.local.json,
# slash-command overrides, session state. The dogfood `.mcp.json` at the
# repo root IS tracked; everything under .claude/ is not.
.claude/

# Smoke-test and eval-suite scratch artifacts (server repo's test/smoke.ts
# and test/eval/). Broad pattern catches crash-leftover files at repo root.
/smoke*
/eval_*
/mcp_smoke_*

# Scratch project the interactive tool sweep creates and tears down. Ignored so
# a sweep that aborts partway leaves nothing tracked behind.
/sv2_validation/

# Engine-generated audio bus layout (recreated from ProjectSettings on load)
/default_bus_layout.tres

# OS / shell crash artifacts
*.stackdump
