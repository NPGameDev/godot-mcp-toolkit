# Godot 4.x editor-local state
.godot/
*.import

# Iter 08 distribution artifacts (AssetLib zip build output)
dist-plugin/

# IDE / editor-specific (user-machine paths, not portable)
.vscode/
.idea/

# Claude Code per-project state (created when running `claude` from this
# repo for dogfood). Local to the dev machine — settings.local.json,
# slash-command overrides, session state. The dogfood `.mcp.json` at the
# repo root IS tracked; everything under .claude/ is not.
.claude/

# Smoke-test scratch artifacts written by the server repo's test/smoke.ts
/smoke_probe.*
/smoke_screenshots/
# Persistent EDITED_SCENE / PATH_IN_USE probes — their editor tabs linger
# for the session (Godot 4.4.1 has no EditorInterface.close_scene), so the
# files and parent folder must persist to keep play-test save_all_scenes
# happy. Swap for true teardown on Godot 4.5.
/smoke_edited_probe.tscn
/smoke_path_in_use/
